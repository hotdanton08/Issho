{
  "name": "issho",
  "version": "0.0.1",
  "description": "Mobile-first Japanese particle practice",
  "productName": "Issho",
  "author": "BUILTIN/Administrators <hotdanton08@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && eslint -c ./eslint.config.js src",
    "lint:check": "prettier --check . && eslint -c ./eslint.config.js src",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "lint:fix": "prettier --write . && eslint --fix -c ./eslint.config.js src",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "pinia": "^4.0.2",
    "quasar": "^2.32.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.8.3",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
